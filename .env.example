# Copie para .env e ajuste.

# Conexão PostgreSQL (local, Docker, Render, Neon, Supabase, Railway…)
DATABASE_URL="postgresql://painel:painel@localhost:5432/painel?schema=public"

PORT=3000

# Fuso usado para "hoje" (vencimentos, prazos de OS). O servidor de deploy roda em UTC.
APP_TZ=America/Sao_Paulo

# Login do painel (HTTP Basic). Deixe vazio só em desenvolvimento.
APP_USER=
APP_PASSWORD=

# Habilita o botão "Restaurar dados de exemplo" (APAGA o banco). Use false em produção.
ALLOW_DEMO_RESET=true
