# Copie para .env e ajuste.

# Conexão PostgreSQL (local, Docker, Railway, Render, Neon, Supabase…)
# No Railway use a referência ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://painel:painel@localhost:5432/painel?schema=public"

PORT=3000

# Fuso usado para "hoje" (vencimentos, prazos de OS). O servidor de deploy roda em UTC.
APP_TZ=America/Sao_Paulo

# Administrador inicial: criado na primeira inicialização se ainda não existir.
# Obrigatório em produção (lá não há outro jeito de ter o primeiro admin).
# Em desenvolvimento, sem isso, o primeiro cadastro feito na tela de login vira admin.
# A senha só é usada na criação; depois troque pelo menu do usuário.
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Nome, cor, cadastro público e validade de convites são configurados no próprio
# painel (Administração → Configurações), não aqui.

# Habilita o botão "Restaurar dados de exemplo" (APAGA o banco). Use false em produção.
ALLOW_DEMO_RESET=true
